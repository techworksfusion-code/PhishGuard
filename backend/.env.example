PORT=5000
DATABASE_URL=sqlite://./data/phishguard.db
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
ALERT_PEPPER=change_this_to_a_32_byte_random_string
SCAN_RATE_PER_TOKEN=20
GEMINI_DAILY_MAX=100
OTP_CHANNEL=console
TOKEN_PEPPER=change_this_to_a_32_byte_random_string
WHATSAPP_SESSION_DIR=./sessions
WHATSAPP_BOT_ENABLED=false
# Public E.164 number users should message to link their WhatsApp.
WHATSAPP_PUBLIC_NUMBER=

# Optional passive dynamic analysis worker. Use an isolated, disposable worker;
# never run untrusted page rendering directly in the public API process.
SANDBOX_API_BASE_URL=
SANDBOX_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
APP_WEBHOOK_BASE_URL=
WEBHOOK_SIGNING_SECRET=

# Telegram bot used for user linking and report delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# — Gmail SMTP (needed when OTP_CHANNEL=smtp) —
# SMTP_PASS must be a 16-char App Password, NOT the Google account password.
# Google Account → Security → 2-Step Verification ON → App passwords → create.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmailaddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=PhishGuard OTP <yourgmailaddress@gmail.com>

# — Google sign-in ("Continue with Google") —
# Create an OAuth client at console.cloud.google.com (Web application) with
# Authorized redirect URI: http://localhost:5173/auth/google/callback
# (replace host/origin for deployed builds). Both vars optional; without them
# GET /api/auth/google/url returns 503 and the frontend keeps the email/phone path.
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_web_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
